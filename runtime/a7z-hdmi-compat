#!/usr/bin/python3 -B
"""Recover a connected HDMI output left disabled by the T5 driver at X startup.

Use the connected display's current/preferred mode. Try an ordinary modeset
first, and hold HPD connected only if the driver's output-disable fault recurs.
The fallback bypasses physical hotplug until the display manager stops. This
bounded startup workaround is not a kernel fix or a hotplug monitoring daemon.
"""
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys
import syslog
import time

CONNECTOR = Path('/sys/class/drm/card0-HDMI-A-1')
MASK = Path('/sys/class/hdmi/hdmi/attr/hpd_mask')
SOURCE = Path('/sys/class/hdmi/hdmi/attr/hdmi_source')
MARKER = Path('/run/a7z-hdmi-compat.json')
LOCK = Path('/run/a7z-hdmi-compat.lock')
OUTPUT = 'HDMI-1'


def log(message):
    syslog.openlog('a7z-hdmi-compat')
    syslog.syslog(syslog.LOG_NOTICE, message)
    print('a7z-hdmi-compat: ' + message, flush=True)


def valid_edid(data):
    if (len(data) < 128 or len(data) > 4096 or len(data) % 128
            or data[:8] != b'\x00\xff\xff\xff\xff\xff\xff\x00'
            or len(data) != 128 * (1 + data[126])
            or any(sum(data[p:p+128]) % 256 for p in range(0, len(data), 128))):
        return False
    return True


def connected_edid():
    try:
        if (CONNECTOR / 'status').read_text().strip() != 'connected':
            return None
        # sysfs EDID files report size zero; read the actual bytes explicitly.
        with (CONNECTOR / 'edid').open('rb') as stream:
            data = stream.read(4097)
        return data if valid_edid(data) else None
    except OSError:
        return None


def monitor_ready(deadline):
    for attempt in range(3):
        data = connected_edid()
        if data is not None:
            return data
        if attempt < 2:
            pause(0.2, deadline)
    return None


def read_mask():
    found = re.search(r'Current hpd mask value:\s*(0x[0-9a-fA-F]+)', MASK.read_text())
    if not found:
        raise RuntimeError('unrecognized HPD status')
    return int(found[1], 16)


def write_mask(value):
    # The vendor interface parses base 16, including strings without a prefix.
    MASK.write_text(f'0x{value:x}\n')
    if read_mask() != value:
        raise RuntimeError('HPD setting did not read back')


def marker_value(manager):
    return {'schema': 2, 'reason': 'hpd-output-recovery', 'mask': 0x11,
            'manager': manager}


def owns_marker(manager):
    try:
        info = MARKER.lstat()
        return (stat.S_ISREG(info.st_mode) and info.st_uid == 0
                and not info.st_mode & 0o077
                and json.loads(MARKER.read_text()) == marker_value(manager))
    except (OSError, ValueError):
        return False


def mark_owned(manager):
    if owns_marker(manager):
        return
    fd = os.open(MARKER, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as stream:
        json.dump(marker_value(manager), stream)


def release(manager):
    if owns_marker(manager):
        if MASK.exists() and read_mask() == 0x11:
            write_mask(0)
            log('normal HPD detection restored')
        MARKER.unlink()


def run(arguments, timeout=3, deadline=None):
    if deadline is not None:
        timeout = min(timeout, deadline - time.monotonic())
        if timeout <= 0:
            raise TimeoutError('startup recovery time budget exhausted')
    return subprocess.run(arguments, check=True, timeout=timeout,
                          capture_output=True, text=True)


def pause(seconds, deadline):
    if time.monotonic() + seconds > deadline:
        raise TimeoutError('startup recovery time budget exhausted')
    time.sleep(seconds)


def stock_hook(manager, stopping=False):
    if manager == 'sddm':
        run(['/usr/share/sddm/scripts/Xstop' if stopping else
             '/usr/share/sddm/scripts/Xsetup'], timeout=2)


def display_environment(manager):
    display = os.environ.get('DISPLAY', '')
    authority = os.environ.get('XAUTHORITY', '')
    # The board has one local HDMI seat; never act on remote or secondary X.
    if not re.fullmatch(r':0(?:\.0)?', display) or not authority:
        raise RuntimeError('local display manager environment missing')
    info = Path(authority).lstat()
    owners = (0, pwd.getpwnam(manager).pw_uid)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid not in owners
            or info.st_mode & 0o022):
        raise RuntimeError('unexpected Xauthority owner, type or permissions')


def display_mode(deadline):
    query = run(['/usr/bin/xrandr', '--current'], timeout=2,
                deadline=deadline).stdout
    section = re.search(r'^HDMI-1 connected[^\n]*\n((?:[ \t].*\n)*)',
                        query, re.MULTILINE)
    if not section:
        return None
    preferred = None
    for line in section[1].splitlines():
        mode_line = re.fullmatch(r'[ \t]+([^\s-][^\s]*)[ \t]+(.+)', line)
        if not mode_line:
            continue
        for rate in re.finditer(r'(?<!\S)([0-9]+(?:\.[0-9]+)?)([ *+]*)', mode_line[2]):
            if float(rate[1]) <= 0:
                continue
            item = {'mode': mode_line[1], 'rate': rate[1], 'current': '*' in rate[2]}
            if item['current']:
                return item
            if '+' in rate[2] and preferred is None:
                preferred = item
    return preferred


def driver_state():
    # T5's [drv state] row: state | clock | output | thread | hpd | mask | ...
    # Do not confuse this with [drv cfg], PHY PLL or optional sink SCDC fields.
    section = re.search(r'^\[drv state\]\s*\n(.*?)(?=^\[|\Z)',
                        SOURCE.read_text(), re.MULTILINE | re.DOTALL)
    if section:
        for line in section[1].splitlines():
            fields = [part.strip() for part in line.split('|') if part.strip()]
            if len(fields) >= 6 and fields[0] == 'state':
                clock, output, hpd = fields[1], fields[2], fields[4]
                if clock in ('on', 'off') and output in ('on', 'off') and hpd in ('in', 'out'):
                    return clock, output, hpd
    raise RuntimeError('unrecognized HDMI driver output status')


def observe_fault(edid, deadline, seconds=4):
    end = time.monotonic() + seconds
    consecutive = 0
    while True:
        state = driver_state()
        if state == ('on', 'off', 'in') and connected_edid() == edid:
            consecutive += 1
            if consecutive >= 2:
                mode = display_mode(deadline)
                # An inactive X output alone is not evidence of the HPD fault.
                if mode and mode['current'] and connected_edid() == edid:
                    return mode
        else:
            consecutive = 0
        remaining = end - time.monotonic()
        if remaining <= 0:
            return None
        pause(min(0.5, remaining), deadline)


def enable(mode, deadline):
    run(['/usr/bin/xrandr', '--output', OUTPUT, '--mode', mode['mode'],
         '--rate', mode['rate'], '--primary'], deadline=deadline)


def cycle(mode, deadline):
    run(['/usr/bin/xrandr', '--output', OUTPUT, '--off'], deadline=deadline)
    enable(mode, deadline)


def setup(manager, deadline):
    if not MASK.exists() or not SOURCE.exists() or not CONNECTOR.exists():
        release(manager)
        log('skipped: T5 HDMI status interface not found')
        return
    display_environment(manager)
    edid = monitor_ready(deadline)
    if edid is None:
        release(manager)
        log('skipped: connected display with a valid EDID not found')
        return
    previous = read_mask()
    if previous != 0 and not (previous == 0x11 and owns_marker(manager)):
        log('skipped: HPD setting is managed elsewhere')
        return
    # A repeated setup invocation starts with ordinary HPD detection again.
    release(manager)
    modified = False
    try:
        mode = display_mode(deadline)
        if not mode:
            log('skipped: connected output has no current or preferred X mode')
            return
        if connected_edid() != edid:
            raise RuntimeError('display changed during setup')
        if not mode['current']:
            # Restore a disabled X output normally before considering a quirk.
            modified = True
            enable(mode, deadline)
        mode = observe_fault(edid, deadline)
        if mode is None:
            log('startup observation finished without a persistent output-disable fault')
            return
        log('connected X output is active but driver output is disabled; retrying modeset')
        modified = True
        cycle(mode, deadline)
        mode = observe_fault(edid, deadline)
        if mode is None:
            log('ordinary modeset completed without a recurring output-disable fault')
            return
        # Force HPD only after an ordinary modeset failed to keep output on.
        # Recheck identity and ownership immediately before modifying the mask.
        if connected_edid() != edid or read_mask() != 0:
            raise RuntimeError('display or HPD ownership changed before fallback')
        current = display_mode(deadline)
        if not current or not current['current'] or connected_edid() != edid:
            raise RuntimeError('connected active output changed before fallback')
        mode = current
        mark_owned(manager)
        write_mask(0x11)
        pause(0.2, deadline)  # Let an already sampled HPD transition finish.
        cycle(mode, deadline)
        pause(1, deadline)
        if driver_state() != ('on', 'on', 'in') or connected_edid() != edid:
            raise RuntimeError('HPD fallback did not restore driver output state')
        log('HPD fallback applied; driver reports output on at '
            + mode['mode'] + ' / ' + mode['rate'] + ' Hz')
    except Exception:
        if modified:
            try:
                # Reserve up to three seconds beyond the main work deadline.
                run(['/usr/bin/xrandr', '--output', OUTPUT, '--auto', '--primary'])
            except Exception:
                log('fallback output enable failed')
        release(manager)
        raise


def main():
    if os.geteuid() != 0:
        log('skipped: root privileges required')
        return 0
    arguments = sys.argv[1:]
    if (not arguments or arguments[0] not in ('--lightdm', '--sddm')
            or arguments[1:] not in ([], ['--stop'])):
        log('usage: a7z-hdmi-compat --lightdm|--sddm [--stop]')
        return 0
    manager = arguments[0][2:]
    stopping = arguments[1:] == ['--stop']
    # Includes stock Xsetup; leave three seconds for rollback below SDDM's 30 s.
    deadline = time.monotonic() + 22
    try:
        # Chain the stock SDDM hook even when this quirk is inapplicable.
        if not stopping:
            stock_hook(manager)
        fd = os.open(LOCK, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'w') as lock:
            info = os.fstat(lock.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0
                    or info.st_mode & 0o077):
                raise RuntimeError('unexpected runtime lock owner or permissions')
            # Never block a display manager behind another compatibility hook.
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if stopping:
                release(manager)
            else:
                setup(manager, deadline)
    except Exception as error:
        log('compatibility hook skipped or failed (' + type(error).__name__
            + '); allowing display manager to continue')
    finally:
        if stopping:
            try:
                stock_hook(manager, stopping=True)
            except Exception as error:
                log('stock stop hook failed (' + type(error).__name__ + ')')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

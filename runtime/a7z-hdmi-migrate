#!/usr/bin/env python3
"""Retire only the project's pre-kernel-fix HDMI login hooks."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import tempfile

MARKER = "# Managed by a7z rootfs builder.\n"
CONFIGS = {
    "etc/lightdm/lightdm.conf.d/95-a7z-hdmi-compat.conf": (
        "[Seat:*]\n",
        "display-setup-script=/usr/bin/a7z-hdmi-compat --lightdm\n",
        "display-stopped-script=/usr/bin/a7z-hdmi-compat --lightdm --stop\n",
    ),
    "etc/sddm.conf.d/95-a7z-hdmi-compat.conf": (
        "[X11]\n",
        "DisplayCommand=/usr/bin/a7z-hdmi-compat --sddm\n",
        "DisplayStopCommand=/usr/bin/a7z-hdmi-compat --sddm --stop\n",
    ),
}
LEGACY_HELPER_SHA256 = "94d99432343f5aaa0a8c92158903d764c3a011a6b8eab679bfbe976145721f8a"


def isolated_path(root, relative):
    path = root / relative
    for component in (path, *path.parents):
        if component == root:
            break
        if component.is_symlink():
            raise ValueError(f"Preserved symlink instead of following it: {relative}")
    if path.exists() and not path.is_file():
        raise ValueError(f"Preserved non-file: {relative}")
    return path


def replace_file(path, contents):
    metadata = path.stat()
    fd, temporary = tempfile.mkstemp(prefix=".a7z-hdmi-migrate-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(contents)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, stat.S_IMODE(metadata.st_mode))
        os.chown(temporary, metadata.st_uid, metadata.st_gid)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def migrate(root):
    result = {"removed": [], "updated": [], "preserved": [], "warnings": []}
    for base, stock in CONFIGS.items():
        for relative in (base, base + ".disabled"):
            try:
                path = isolated_path(root, relative)
                if not path.exists():
                    continue
                contents = path.read_bytes().decode("utf-8")
                if contents in ("".join(stock), MARKER + "".join(stock)):
                    path.unlink()
                    result["removed"].append(relative)
                    continue
                # Keep custom settings, comments and unrelated sections byte-for-byte.
                # Only remove the exact old project commands in their original section.
                section = ""
                retained = []
                changed = False
                for line in contents.splitlines(keepends=True):
                    stripped = line.strip()
                    if stripped.startswith("[") and stripped.endswith("]"):
                        section = stripped
                    if section == stock[0].strip() and line.rstrip("\r\n") in {
                        command.rstrip("\n") for command in stock[1:]
                    }:
                        changed = True
                        continue
                    retained.append(line)
                remaining = "".join(retained)
                if changed:
                    replace_file(path, remaining.encode("utf-8"))
                    result["updated"].append(relative)
                else:
                    result["preserved"].append(relative)
                if any("a7z-hdmi-compat" in line and not line.lstrip().startswith(("#", ";"))
                       for line in remaining.splitlines()):
                    result["warnings"].append(
                        f"Custom legacy HDMI command preserved in {relative}; remove or replace it before restarting the display manager")
            except (OSError, UnicodeError, ValueError) as error:
                result["warnings"].append(str(error))
    # pacman removes this old package-owned file during normal upgrades. This
    # branch also handles offline roots where the old file was copied manually.
    relative = "usr/bin/a7z-hdmi-compat"
    try:
        path = isolated_path(root, relative)
        if path.exists():
            if hashlib.sha256(path.read_bytes()).hexdigest() == LEGACY_HELPER_SHA256:
                path.unlink()
                result["removed"].append(relative)
            else:
                result["preserved"].append(relative)
                result["warnings"].append(f"Modified legacy helper preserved: {relative}")
    except (OSError, ValueError) as error:
        result["warnings"].append(str(error))
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path("/"))
    parser.add_argument("--strict", action="store_true", help="Fail image construction if custom legacy hooks remain")
    args = parser.parse_args()
    root = args.root.resolve()
    if not (root / "etc/arch-release").is_file():
        parser.error("--root must name an Arch root filesystem")
    result = migrate(root)
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 1 if args.strict and result["warnings"] else 0


if __name__ == "__main__":
    raise SystemExit(main())
